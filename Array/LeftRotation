public static void leftRotateByOne(int[] arr) {

    if (arr == null || arr.length <= 1) return;

    int first = arr[0];

    for (int i = 0; i < arr.length - 1; i++) {
        arr[i] = arr[i + 1];
    }

    arr[arr.length - 1] = first;
}

