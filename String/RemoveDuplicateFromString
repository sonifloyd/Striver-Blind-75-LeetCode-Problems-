import java.util.HashSet;

public class Main {
    public static void main(String[] args) {

        String s = "sssrp";
        HashSet<Character> set = new HashSet<>();

        String result = "";

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (!set.contains(ch)) {
                set.add(ch);
                result = result + ch;
            }
        }

        System.out.println(result);
    }
}

