Optimal Approach (String Trick)

If lengths differ → false

Create s + s

Check if goal is a substring

----
class Solution {
    public boolean rotateString(String s, String goal) {
        if (s.length() != goal.length()) return false;
        return (s + s).contains(goal);
    }
}
-----
Complexity

Time: O(n)

Space: O(n)

---------------------------
class Solution {
    public boolean rotateString(String s, String goal) {
        if (s.length() != goal.length()) return false;

        int n = s.length();
        for (int i = 0; i < n; i++) {
            if (s.substring(i) + s.substring(0, i).equals(goal)) {
                return true;
            }
        }
        return false;
    }
}
